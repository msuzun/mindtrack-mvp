{
  "expo": {
    "name": "MindTrack",
    "slug": "mindtrack",
    "version": "2.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "mindtrack",
    "icon": "./assets/app-icons/icon-zen-blue.png",
    "android": {
      "package": "com.sevkiuzun.mindtrack",
      "versionCode": 23,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icons/icon-zen-foreground.png",
        "backgroundColor": "#0f172a"
      }
    },
    "ios": {
      "bundleIdentifier": "com.sevkiuzun.mindtrack",
      "buildNumber": "23",
      "supportsTablet": true,
      "icon": "./assets/app-icons/icon-zen-blue.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleIcons": {
          "CFBundleAlternateIcons": {
            "AppIcon-Midnight": { "CFBundleIconFiles": ["AppIcon-Midnight"], "UIPrerenderedIcon": true },
            "AppIcon-PureLight": { "CFBundleIconFiles": ["AppIcon-PureLight"], "UIPrerenderedIcon": true },
            "AppIcon-SolarSunset": { "CFBundleIconFiles": ["AppIcon-SolarSunset"], "UIPrerenderedIcon": true }
          }
        },
        "CFBundleIcons~ipad": {
          "CFBundleAlternateIcons": {
            "AppIcon-Midnight": { "CFBundleIconFiles": ["AppIcon-Midnight"], "UIPrerenderedIcon": true },
            "AppIcon-PureLight": { "CFBundleIconFiles": ["AppIcon-PureLight"], "UIPrerenderedIcon": true },
            "AppIcon-SolarSunset": { "CFBundleIconFiles": ["AppIcon-SolarSunset"], "UIPrerenderedIcon": true }
          }
        }
      }
    },
    "plugins": [
      "./plugins/withAlternateAppIcons",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#38bdf8",
          "defaultChannel": "daily-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc",
          "dark": {
            "image": "./assets/app-icons/icon-zen-foreground.png",
            "backgroundColor": "#0f172a"
          },
          "image": "./assets/app-icons/icon-zen-foreground.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://msuzun.github.io/Mindtrack-WebPages/Privacy/",
      "supportUrl": "https://msuzun.github.io/Mindtrack-WebPages/Support/",
      "eas": {
        "projectId": "ba7feea4-d7db-4258-995d-c490a36efbe3"
      }
    }
  }
}
